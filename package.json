{
  "name": "svws-gradehub",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:full": "concurrently \"npm run server\" \"npm run dev\"",
    "server": "node server.js",
    "start": "node server.js",
    "package:offline": "npm run build && mkdir -p release && cd dist && zip -r \"../release/gradehub-$(node -p \"require('../package.json').version\")-offline.zip\" . && cd .. && echo \"→ release/gradehub-$(node -p \"require('./package.json').version\")-offline.zip\"",
    "package:server": "npm run build:web && mkdir -p release && zip -r \"release/gradehub-$(node -p \"require('./package.json').version\")-server.zip\" dist/ server.js package.json package-lock.json && echo \"→ release/gradehub-$(node -p \"require('./package.json').version\")-server.zip\"",
    "package:all": "npm run package:offline && npm run package:server && npm run build",
    "electron:dev": "npm run build && node scripts/write-electron-config.mjs && GSETTINGS_SCHEMA_DIR=$HOME/.local/share/electron-schemas electron . --no-sandbox --ozone-platform=x11",
    "electron:build": "npm run build && node scripts/write-electron-config.mjs && electron-builder",
    "release": "node scripts/release.mjs",
    "release:build": "node scripts/release-build.mjs",
    "release:github": "gh release create v$npm_package_version --draft --title \"Release $npm_package_version\" --notes \"\" release/gradehub-$npm_package_version-webserver.zip release/gradehub-$npm_package_version-node-server.zip release/SVWS-GradeHub-$npm_package_version.AppImage release/SVWS-GradeHub-Setup-$npm_package_version.exe",
    "dev:offline": "vite --config vite.offline.config.ts",
    "build": "vue-tsc --noEmit && vite build --config vite.offline.config.ts",
    "build:web": "vue-tsc --noEmit && vite build",
    "build:offline": "npm run build",
    "offline": "npm run build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "build": {
    "appId": "de.skinwalker.svws-gradehub",
    "productName": "SVWS-GradeHub",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server.js",
      "package.json"
    ],
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "oneClick": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SVWS-GradeHub",
      "menuCategory": "SVWS"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png"
    }
  },
  "dependencies": {
    "express": "^5.2.1",
    "fflate": "^0.8.2",
    "jspdf": "^4.2.1",
    "marked": "^18.0.3",
    "nodemailer": "^8.0.7",
    "pinia": "^2.1.7",
    "vue": "^3.5.0",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.0",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/eslint-config-typescript": "^14.1.3",
    "concurrently": "^10.0.3",
    "electron": "^42.3.1",
    "electron-builder": "^26.8.1",
    "eslint": "^9.15.0",
    "eslint-plugin-vue": "^9.31.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.15.0",
    "vite": "^8.0.16",
    "vite-plugin-singlefile": "^2.3.2",
    "vitest": "^4.1.8",
    "vue-tsc": "^2.2.0"
  }
}
